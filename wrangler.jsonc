{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rwjblue-com",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "TRAINING_DB",
      "database_name": "rwjblue-cw-training",
      "database_id": "e514c6ec-9402-4bf5-8ef4-cd4f6aeb26dc",
      "migrations_dir": "migrations/cw-training"
    }
  ],
  "vars": {
    "TRAINING_ACCESS_TEAM": "",
    "TRAINING_ACCESS_AUD": "",
    "TRAINING_OWNER_EMAIL": "me@rwjblue.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/radio/cw-practice/calendar.ics",
      "/api/cw-training/*",
      "/api/cw-training-calendar/*"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Calendar subscription URLs contain bearer capabilities. Keep them out
      // of automatic request logs; application logs never include private data.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "rwjblue.com",
      "custom_domain": true
    },
    {
      "pattern": "n1rwj.com",
      "custom_domain": true
    }
  ]
}
