---
import { parkPhotoProcessing } from "../lib/pota/ri-park-images";
import type { RiParkPhoto } from "../lib/pota/ri-park-images";

interface Props {
  photo: RiParkPhoto;
}
const { photo } = Astro.props;
const { image } = photo;
---

<figure class="park-photo" data-park-photo>
  <img
    src={photo.src}
    srcset={photo.srcset}
    sizes="(max-width: 708px) calc(100vw - 28px), (max-width: 820px) 680px, (max-width: 1080px) calc(100vw - 40px), 1040px"
    width={photo.width}
    height={photo.height}
    alt={image.alt}
    loading="eager"
    decoding="async"
  />
  <figcaption>
    <p>
      {image.caption && <span>{image.caption}. </span>}
      Photo: {image.credit}. <a href={image.source.pageUrl} target="_blank" rel="noreferrer">Source</a>
      {" · "}<a href={image.rights.url} target="_blank" rel="license noreferrer">{image.rights.label}</a>.
    </p>
    <details>
      <summary>Image processing</summary>
      <ul>
        {image.transforms.map((transform) => <li>{transform}</li>)}
        <li>{parkPhotoProcessing}</li>
      </ul>
    </details>
  </figcaption>
</figure>

<style>
  .park-photo {
    margin: 32px 0 0;
  }

  .park-photo img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
  }

  .park-photo figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .park-photo p {
    margin: 0;
  }

  .park-photo a {
    color: var(--blue);
  }

  .park-photo details {
    margin-top: 5px;
  }

  .park-photo summary {
    cursor: pointer;
    width: fit-content;
  }

  .park-photo ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
</style>
