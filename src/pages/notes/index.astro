---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagLinks from "../../components/TagLinks.astro";
import { formatDate } from "../../lib/format";
import { getDraftNotes, getPublicNotes } from "../../lib/notes";

const notes = (await getPublicNotes()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const drafts = (await getDraftNotes()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Notes / Robert Jackson" searchable={false}>
  <section class="page-intro">
    <p class="eyebrow">Notes</p>
    <h1>Notes</h1>
    <p>
      Lightweight technical notes, field logs, experiments, and fragments worth
      being able to find again.
    </p>
  </section>

  {
    drafts.length > 0 && (
      <section class="draft-index" aria-labelledby="draft-index-title">
        <div class="section-heading">
          <p class="section-label">Preview only</p>
          <h2 id="draft-index-title">Working drafts</h2>
          <p>
            These notes are available in this preview environment but are not
            included in the production site.
          </p>
        </div>
        <ol class="entry-list full">
          {drafts.map((note) => (
            <li>
              <time datetime={note.data.date.toISOString()}>
                {formatDate(note.data.date)}
              </time>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              <p>{note.data.summary}</p>
              <div class="tags">
                <em>Draft</em>
                <TagLinks tags={note.data.tags} />
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <ol class="entry-list full">
    {
      notes.map((note) => (
        <li>
          <time datetime={note.data.date.toISOString()}>
            {formatDate(note.data.date)}
          </time>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <p>{note.data.summary}</p>
          <div class="tags">
            <TagLinks tags={note.data.tags} />
          </div>
        </li>
      ))
    }
  </ol>

  <nav class="section-more" aria-label="Tag index">
    <a href="/tags/">Browse all tags</a>
  </nav>
</BaseLayout>
