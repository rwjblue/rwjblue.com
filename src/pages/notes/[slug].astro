---
import { createHash } from "node:crypto";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GeoJsonBoundaryMap from "../../components/GeoJsonBoundaryMap.astro";
import NcdxfBeaconMap from "../../components/NcdxfBeaconMap.astro";
import PotaContactMap from "../../components/PotaContactMap.astro";
import TagHints from "../../components/TagHints.astro";
import TagLinks from "../../components/TagLinks.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import SeriesNavigation from "../../components/SeriesNavigation.astro";
import { contactMapForNote } from "../../data/pota/contact-maps";
import { formatDate, formatPublicationDateTime } from "../../lib/format";
import { notePublicationDate } from "../../lib/note-publication";
import {
  getRenderableNotes,
  isScheduledNote,
} from "../../lib/notes";
import {
  getPublicSeries,
  seriesContextForNote,
} from "../../lib/relationships";
import {
  articleStructuredData,
  personStructuredData,
} from "../../lib/structured-data";

export async function getStaticPaths() {
  const notes = await getRenderableNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const formattedDate = formatDate(note.data.date, "long");
const contactMap = contactMapForNote(note);
const shouldUseGeneratedShareImage = contactMap || note.data.boundaryMap;
const defaultShareImage = `/notes/${note.id}/share.png${note.data.beaconMap ? "?v=4" : ""}`;
const shareImageBase = shouldUseGeneratedShareImage
  ? `/images/pota/${note.id}/share.png`
  : note.data.shareImage ?? defaultShareImage;
const shareImageCacheKey = createHash("sha256")
  .update(
    JSON.stringify({
      id: note.id,
      title: note.data.title,
      summary: note.data.summary,
      date: note.data.date.toISOString(),
      publishAt: note.data.publishAt?.toISOString(),
      visibility: note.data.visibility,
      tags: note.data.tags,
      shareImage: note.data.shareImage,
      beaconMap: note.data.beaconMap,
      contactMap: note.data.contactMap,
      boundaryMap: note.data.boundaryMap,
    }),
  )
  .digest("hex")
  .slice(0, 12);
const shareImage = `${shareImageBase}${shareImageBase.includes("?") ? "&" : "?"}h=${shareImageCacheKey}`;
const shareImageAlt = `${note.data.title} social share image`;
const isScheduled = isScheduledNote(note);
const isPreview = note.data.visibility !== "public" || isScheduled;
const visibilityState = isScheduled ? "scheduled" : note.data.visibility;
const visibilityLabel = isScheduled
  ? "Scheduled preview"
  : note.data.visibility === "draft"
    ? "Draft preview"
    : "Unlisted note";
const visibilityDescription = isScheduled
  ? `This note is scheduled to publish on ${formatPublicationDateTime(
      note.data.publishAt!,
    )}.`
  : note.data.visibility === "draft"
    ? "This working draft is only available in draft-enabled preview environments."
    : "This note is available by direct URL but is omitted from indexes, feeds, and search results.";
const notePath = `/notes/${note.id}/`;
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Notes", path: "/notes/" },
  { name: note.data.title, path: notePath },
];
const structuredData = isPreview
  ? undefined
  : [
      personStructuredData,
      articleStructuredData({
        title: note.data.title,
        description: note.data.summary,
        path: notePath,
        published: notePublicationDate(note),
        image: shareImage.split("?")[0],
      }),
    ];
const seriesContext = isPreview
  ? undefined
  : seriesContextForNote(note, await getPublicSeries());
---

<BaseLayout
  title={`${note.data.title} / Notes / Robert Jackson`}
  socialTitle={note.data.title}
  description={note.data.summary}
  canonicalPath={`/notes/${note.id}/`}
  image={shareImage}
  imageAlt={shareImageAlt}
  type="article"
  robots={isPreview ? "noindex, nofollow" : undefined}
  searchable={!isPreview}
  structuredData={structuredData}
  backlinks={!isPreview}
  searchType={!isPreview ? "Note" : undefined}
>
  <Breadcrumbs items={breadcrumbs} />
  <article
    class="document"
  >
    {
      isPreview && (
        <aside class={`note-visibility note-visibility--${visibilityState}`}>
          <strong>{visibilityLabel}</strong>
          <span>{visibilityDescription}</span>
        </aside>
      )
    }
    <header>
      <p class="eyebrow">Note</p>
      <h1>{note.data.title}</h1>
      <p class="meta">{formattedDate}</p>
      <p>{note.data.summary}</p>
      <div class="tags">
        <TagLinks tags={note.data.tags} pagefindFilters={!isPreview} />
      </div>
    </header>
    <TagHints tags={note.data.tags} />
    {note.data.beaconMap && <NcdxfBeaconMap />}
    {contactMap && <PotaContactMap map={contactMap} />}
    {note.data.boundaryMap && <GeoJsonBoundaryMap map={note.data.boundaryMap} />}
    <Content />
    {seriesContext && <SeriesNavigation context={seriesContext} />}
    {!isPreview && <RelatedContent currentType="note" currentId={note.id} />}
  </article>
</BaseLayout>
