---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GeoJsonBoundaryMap from "../../components/GeoJsonBoundaryMap.astro";
import NcdxfBeaconMap from "../../components/NcdxfBeaconMap.astro";
import PotaContactMap from "../../components/PotaContactMap.astro";
import TagHints from "../../components/TagHints.astro";
import TagLinks from "../../components/TagLinks.astro";
import { contactMapForNote } from "../../data/pota/contact-maps";
import { formatDate } from "../../lib/format";
import { getRenderableNotes } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getRenderableNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const formattedDate = formatDate(note.data.date, "long");
const contactMap = contactMapForNote(note);
const shouldUseGeneratedShareImage = contactMap || note.data.boundaryMap;
const shareImage = shouldUseGeneratedShareImage
  ? `/images/pota/${note.id}/share.png`
  : note.data.shareImage ??
    `/notes/${note.id}/share.png${note.data.beaconMap ? "?v=4" : ""}`;
const shareImageAlt = `${note.data.title} social share image`;
const isPreview = note.data.visibility !== "public";
const visibilityLabel =
  note.data.visibility === "draft" ? "Draft preview" : "Unlisted note";
const visibilityDescription =
  note.data.visibility === "draft"
    ? "This working draft is only available in draft-enabled preview environments."
    : "This note is available by direct URL but is omitted from indexes, feeds, and search results.";
---

<BaseLayout
  title={`${note.data.title} / Notes / Robert Jackson`}
  socialTitle={note.data.title}
  description={note.data.summary}
  canonicalPath={`/notes/${note.id}/`}
  image={shareImage}
  imageAlt={shareImageAlt}
  type="article"
  robots={isPreview ? "noindex, nofollow" : undefined}
  searchable={!isPreview}
>
  <article
    class="document"
    data-pagefind-filter={isPreview ? undefined : "type:Note"}
  >
    {
      isPreview && (
        <aside class={`note-visibility note-visibility--${note.data.visibility}`}>
          <strong>{visibilityLabel}</strong>
          <span>{visibilityDescription}</span>
        </aside>
      )
    }
    <header>
      <p class="eyebrow">Note</p>
      <h1>{note.data.title}</h1>
      <p class="meta">{formattedDate}</p>
      <p>{note.data.summary}</p>
      <div class="tags">
        <TagLinks tags={note.data.tags} pagefindFilters={!isPreview} />
      </div>
    </header>
    <TagHints tags={note.data.tags} />
    {note.data.beaconMap && <NcdxfBeaconMap />}
    {contactMap && <PotaContactMap map={contactMap} />}
    {note.data.boundaryMap && <GeoJsonBoundaryMap map={note.data.boundaryMap} />}
    <Content />
  </article>
</BaseLayout>
