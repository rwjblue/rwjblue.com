---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTaggedItems, summarizeTags } from "../lib/tags";

const tags = summarizeTags(await getTaggedItems());
const searchAvailable = !import.meta.env.DEV;
---

<BaseLayout
  title="Search / Robert Jackson"
  description="Search notes, projects, radio guides, and tools on rwjblue.com."
  searchable={false}
>
  <section class="page-intro">
    <p class="eyebrow">Search</p>
    <h1>Search</h1>
    <p>
      Search notes, project pages, radio guides, and tools without leaving the
      site.
    </p>
  </section>

  <section class="site-search" aria-labelledby="site-search-label">
    {
      !searchAvailable && (
        <aside class="search-dev-notice" aria-labelledby="search-dev-title">
          <p class="section-label">Development mode</p>
          <h2 id="search-dev-title">Search needs a production build.</h2>
          <p>
            Pagefind creates its index during <code>mise run build</code>, so
            search is unavailable under <code>mise run dev</code>. Use
            <code>mise run preview</code> after a build to test search locally.
          </p>
        </aside>
      )
    }
    <form class="search-form" role="search" data-search-form>
      <label id="site-search-label" for="site-search">Search the site</label>
      <div>
        <input
          id="site-search"
          name="q"
          type="search"
          placeholder="Try POTA, CW, Astro..."
          autocomplete="off"
          data-search-input
          disabled={!searchAvailable}
        />
        <button type="submit" disabled={!searchAvailable}>Search</button>
      </div>
      <div class="search-filter-row">
        <fieldset>
          <legend>Content type</legend>
          {
            ["Note", "Project", "Radio guide", "Tool"].map((type) => (
              <label>
                <input
                  type="checkbox"
                  value={type}
                  data-search-type
                  disabled={!searchAvailable}
                />
                <span>{type}s</span>
              </label>
            ))
          }
        </fieldset>
        <label class="search-tag-filter">
          Tag
          <select data-search-tag disabled={!searchAvailable}>
            <option value="">All tags</option>
            {
              tags.map((tag) => (
                <option value={tag.tag}>{tag.tag} ({tag.count})</option>
              ))
            }
          </select>
        </label>
      </div>
      {
        searchAvailable && (
          <p class="search-shortcut-hint">
            Press <kbd>/</kbd> from ordinary page content to open search.
          </p>
        )
      }
    </form>

    <p class="search-status" role="status" aria-live="polite" data-search-status>
      {
        searchAvailable
          ? "Enter a word or phrase, or choose a filter."
          : "Search controls are disabled in Astro development mode."
      }
    </p>
    <ol class="search-results" data-search-results></ol>
  </section>
</BaseLayout>

<script>
  import { initSearchPage } from "../lib/search-client";

  initSearchPage();
</script>
