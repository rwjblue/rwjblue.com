---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTaggedItems, summarizeTags } from "../lib/tags";

const tags = summarizeTags(await getTaggedItems());
---

<BaseLayout
  title="Search / Robert Jackson"
  description="Search notes, projects, radio guides, and tools on rwjblue.com."
  searchable={false}
>
  <section class="page-intro">
    <p class="eyebrow">Search</p>
    <h1>Search</h1>
    <p>
      Search notes, project pages, radio guides, and tools without leaving the
      site.
    </p>
  </section>

  <section class="site-search" aria-labelledby="site-search-label">
    <form class="search-form" role="search" data-search-form>
      <label id="site-search-label" for="site-search">Search the site</label>
      <div>
        <input
          id="site-search"
          name="q"
          type="search"
          placeholder="Try POTA, CW, Astro..."
          autocomplete="off"
          data-search-input
        />
        <button type="submit">Search</button>
      </div>
      <div class="search-filter-row">
        <fieldset>
          <legend>Content type</legend>
          {
            ["Note", "Project", "Radio guide", "Tool"].map((type) => (
              <label>
                <input type="checkbox" value={type} data-search-type />
                <span>{type}s</span>
              </label>
            ))
          }
        </fieldset>
        <label class="search-tag-filter">
          Tag
          <select data-search-tag>
            <option value="">All tags</option>
            {
              tags.map((tag) => (
                <option value={tag.tag}>{tag.tag} ({tag.count})</option>
              ))
            }
          </select>
        </label>
      </div>
      <p class="search-shortcut-hint">
        Press <kbd>/</kbd> from ordinary page content to open search.
      </p>
    </form>

    <p class="search-status" role="status" aria-live="polite" data-search-status>
      Enter a word or phrase, or choose a filter.
    </p>
    <ol class="search-results" data-search-results></ol>
  </section>
</BaseLayout>

<script>
  import { initSearchPage } from "../lib/search-client";

  initSearchPage();
</script>
