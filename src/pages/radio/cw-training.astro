---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MORSE_RUNNER_GUIDE_URL, MORSE_RUNNER_BASICS_URL, MORSE_RUNNER_DOWNLOAD_URL, WEB_MORSE_RUNNER_HELP_URL } from "../../lib/cw-training/morse-runner";
import "../../styles/cw-training.css";
---

<BaseLayout
  title="CW training / N1RWJ"
  description="A private practice companion for CW Academy."
  searchable={false}
  robots="noindex, nofollow"
  analytics={false}
>
  <div id="cw-training" class="cw-training" data-pagefind-ignore>
    <header class="training-heading">
      <div>
        <p class="eyebrow">N1RWJ / CW Academy</p><h1>One block at a time.</h1><p
          id="training-course-title"
        >
          Your private training companion.
        </p>
      </div>
      <span id="training-sync-state" class="training-status" role="status"
        >Loading your plan</span
      >
    </header>
    <div id="training-message" class="training-notice" role="status" hidden>
    </div>
    <div id="training-auth" class="training-card" hidden>
      <h2>Your practice, ready when you are.</h2>
      <p>
        Sign in to load your private curriculum and training history. This
        browser will remember your session.
      </p>
      <a class="training-button primary" href="/api/cw-training/login"
        >Sign in</a
      >
    </div>
    <div id="training-app" hidden>
      <nav class="training-tabs" aria-label="Training views">
        <button type="button" data-view="today" aria-current="page"
          >Today</button
        >
        <button type="button" data-view="focus">Focus</button>
        <button type="button" data-view="week">Week</button>
        <button type="button" data-view="materials">Materials</button>
      </nav>

      <section id="training-today" aria-label="Today">
        <div class="training-today-heading">
          <div>
            <p class="eyebrow" id="training-position"></p><h2
              id="training-day-title"
            >
              Today's practice
            </h2>
          </div><p id="training-class-time"></p>
        </div>
        <div class="training-progress">
          <div>
            <strong id="training-minutes">0 / 60 min</strong><span
              >Practice today</span
            >
          </div><progress
            id="training-progress"
            value="0"
            max="60"
            aria-label="Today's practice minutes"></progress><p
            id="training-time-breakdown" class="training-small"
          ></p><p
            id="training-coverage"
          >
          </p>
        </div>
        <div id="training-next" class="training-card training-next"></div>
        <p class="training-small">Choose any exercise. Practice for the time you have; partial listening counts.</p>
        <div class="training-section">
          <h3>Today's assignments</h3><div id="training-queue"></div>
          <section id="training-carried-panel" class="training-carried" aria-labelledby="training-carried-heading" hidden>
            <h4 id="training-carried-heading">Added to today</h4>
            <p class="training-small">Selected for today. Progress stays with the original assignment; unfinished exercises return to earlier work tomorrow.</p>
            <div id="training-carried"></div>
          </section>
        </div>
        <div id="training-blocked"></div>
        <div id="training-preparation"></div>
        <details id="training-today-history-panel" class="training-panel training-today-history">
          <summary>
            <span id="training-today-history-heading">Practiced today</span>
            <span id="training-today-history-summary" class="training-panel-meta"></span>
          </summary>
          <div class="training-panel-body">
            <p class="training-small">Saved sessions, results, and notes. Your current block appears here after you finish and save it.</p>
            <div id="training-today-history"></div>
          </div>
        </details>
        <section class="training-section" aria-labelledby="training-keep-practicing-heading">
          <h3 id="training-keep-practicing-heading">Keep practicing</h3>
          <p class="training-small">Optional practice adds minutes without changing assignment completion.</p>
          <div id="training-regular-practice" class="training-regular-practice"></div>
          <details id="training-extra-panel" class="training-panel" hidden>
            <summary>Extra review</summary>
            <div class="training-panel-body">
              <p class="training-small">Revisit recent course exercises for as long as they are useful.</p>
              <div id="training-extra"></div>
            </div>
          </details>
        </section>
        <details id="training-earlier-panel" class="training-panel" hidden>
          <summary><span id="training-earlier-label">Earlier unfinished preparation</span></summary>
          <div class="training-panel-body">
            <p class="training-small">Still available before class. Choose what is useful; ask your instructor which missed exercises to prioritize.</p>
            <div id="training-earlier"></div>
          </div>
        </details>
        <details id="training-missed-panel" class="training-panel">
          <summary><span id="training-missed-label">Earlier practice</span></summary>
          <div class="training-panel-body" id="training-missed"></div>
        </details>
        <details class="training-panel">
          <summary>Original curriculum instructions</summary>
          <div class="training-panel-body">
            <h3 id="training-assignment-label"></h3>
            <div id="training-assignment-instructions" class="training-original"></div>
            <a id="training-assignment-source" target="_blank" rel="noreferrer">Open the official assignment</a>
            <details class="training-panel">
              <summary>Course instructions</summary>
              <div class="training-panel-body">
                <div id="training-course-instructions" class="training-original"></div>
                <a id="training-course-source" target="_blank" rel="noreferrer">Official curriculum</a>
              </div>
            </details>
          </div>
        </details>
        <div class="training-section training-actions">
          <button type="button" data-action="add-material"
            >Add instructor material</button
          ><button type="button" data-action="manual"
            >Log practice elsewhere</button
          >
        </div>
      </section>

      <section id="training-focus" aria-label="Practice focus" hidden>
        <div id="training-focus-empty" class="training-card">
          <h2>A little practice adds up.</h2><p>
            Choose a block from Today to begin.
          </p><button type="button" data-view="today">Go to Today</button>
        </div>
        <div id="training-focus-content" hidden>
          <p class="eyebrow" id="training-focus-kind"></p><h2
            id="training-focus-title"
          >
          </h2>
          <p id="training-focus-objective"></p>
          <div id="training-listening-guidance" class="training-guidance" hidden>
            <p class="eyebrow">Suggested approach</p>
            <p id="training-listening-approach"></p>
            <p id="training-listening-passes" class="training-small"></p>
          </div>
          <div class="training-card">
            <div class="training-focus-meta">
              <div>
                <span class="training-timer" id="training-timer">00:00</span
                ><span class="training-small">active practice</span>
              </div><p id="training-focus-target"></p>
            </div>
            <div id="training-audio-box" hidden>
              <p id="training-recording-label" class="training-small"></p>
              <div id="training-focus-speed"></div>
              <p id="training-focus-speed-help" class="training-small" hidden>Change speed here anytime. The new recording starts paused at the beginning of the current pass. Your practice time, completed passes, and scratchpad stay intact. All speeds used are saved with this block.</p>
              <p id="training-pass-count" class="training-pass-count"></p>
              <audio id="training-audio" controls preload="metadata"></audio>
              <div class="training-actions">
                <button type="button" data-action="replay">Replay 8 sec</button
                ><button type="button" data-action="bookmark"
                  >Mark difficult here</button
                >
              </div>
              <p id="training-audio-state" class="training-small" role="status">
                Tap play to begin listening.
              </p>
              <div class="training-recall">
                <div class="training-actions">
                  <button id="training-recall-toggle" type="button" data-action="toggle-recall" aria-pressed="false">Start recall</button>
                  <button type="button" data-action="listen">Resume listening</button>
                </div>
                <p id="training-recall-time" class="training-small">00:00 recall included in active practice</p>
                <p class="training-small">Start recall to time focused thinking or notes with audio paused. Ordinary pauses and breaks do not count. Instructor directions take precedence.</p>
              </div>
              <div id="training-bookmarks" class="training-actions"></div>
              <label class="training-check"
                ><input id="training-recall-pause" type="checkbox" /> Pause for recall
                between passes</label
              >
              <p class="training-small">
                Audio streams from the official source and needs a connection.
                Played time and pass coverage are recorded separately.
              </p>
            </div>
            <div id="training-timer-box">
              <button
                id="training-timer-toggle"
                class="primary"
                type="button"
                data-action="toggle-timer">Start timer</button
              ><p class="training-small">
                Pause when you stop practicing. If you switch apps, confirm
                those minutes when finishing.
              </p>
            </div>
            <div id="training-focus-resource"></div>
          </div>
          <section id="training-runner-embedded" class="training-section" aria-labelledby="training-runner-embedded-heading" hidden>
            <h3 id="training-runner-embedded-heading">Practice here</h3>
            <p id="training-runner-status" class="training-small" role="status" tabindex="-1"></p>
            <p id="training-runner-progress" class="training-small"></p>
            <p class="training-small">The assignment supplies starting defaults. Change mode, duration, activity, or conditions before Run; adjust CW Speed before or during a run. Actual settings are recorded. A keyboard is recommended. Click inside the simulator before using shortcuts. These are synthetic practice calls, not on-air contacts.</p>
            <div id="training-runner-frame-host"></div>
            <div id="training-runner-restart-actions" class="training-notice" hidden>
              <div class="training-actions">
                <button id="training-runner-restart" class="primary" type="button" data-action="restart-runner" aria-describedby="training-runner-restart-help">Save &amp; start new run</button>
                <button type="button" data-action="finish">Finish block</button>
              </div>
              <p id="training-runner-restart-help" class="training-small">Starting a new run resets the simulator's timer, score, and transcript, keeping your settings. Saved time from separate required runs adds toward the assignment; each run keeps its own result summary in history. Click Run in the fresh simulator when ready.</p>
            </div>
            <p id="training-runner-result" class="training-small" hidden></p>
          </section>
          <section id="training-runner-guidance" class="training-guidance training-runner" aria-labelledby="training-runner-heading" hidden>
            <h3 id="training-runner-heading">Web Morse Runner setup</h3>
            <p><a href={WEB_MORSE_RUNNER_HELP_URL} target="_blank" rel="noreferrer">Web version instructions</a></p>
            <p>Assignment: <strong id="training-runner-run"></strong></p>
            <p id="training-runner-mode"></p>
            <p id="training-runner-conditions" class="training-small"></p>
            <div id="training-runner-external-help">
              <p class="training-small">For the standalone runner, enter your station Call, set CW Speed and Run for minutes to the assignment above, and choose a comfortable Pitch. Check these each session; that runner remembers settings separately.</p>
              <p class="training-small">When practicing outside this page, keep the runner awake. Return here to Finish block and confirm actual minutes and results, or use Done elsewhere for a separate run. Only the embedded runner reports its timer and score automatically.</p>
            </div>
            <details>
              <summary>During the run: keys &amp; troubleshooting</summary>
              <p class="training-small">On Mac, use the on-screen F1-F8 buttons if your function keys control volume or brightness.</p>
              <p>Copy the callsign into Call, then press Enter after the station finishes. Copy its serial number into Nr. (RST fills automatically), then Enter to log.</p>
              <dl class="training-runner-keys">
                <dt><kbd>F7</kbd></dt><dd>Request another copy of the call or exchange.</dd>
                <dt><kbd>F2</kbd></dt><dd>Repeat your exchange when asked NR? or AGN.</dd>
                <dt><kbd>F5</kbd></dt><dd>Send the partial callsign you have copied to prompt a correction.</dd>
                <dt><kbd>F1</kbd></dt><dd>Call CQ when needed. Single Call starts without CQ.</dd>
              </dl>
              <p class="training-small">Cut numbers: T/O = 0, N = 9, A = 1, E = 5. In Chk, NR flags an incorrect serial; repeated NILs are a reason to check your Enter timing and exchange sequence.</p>
              <p class="training-small">After the run, the page-icon button reveals a transcript for reviewing missed exchanges. Record Verified Pts, score, and questions before starting another run clears the results.</p>
            </details>
            <details>
              <summary>CWops guides &amp; desktop version</summary>
              <p class="training-small">These guides describe the desktop interface. Use the web Mode labels above; its duration and band-condition behavior differ. Your original assignment and instructor's directions still take precedence.</p>
              <p><a href={MORSE_RUNNER_GUIDE_URL} target="_blank" rel="noreferrer">CWops Morse Runner CE guide (PDF)</a></p>
              <p><a href={MORSE_RUNNER_BASICS_URL} target="_blank" rel="noreferrer">CWops exchange walkthrough (PDF, older interface)</a></p>
              <p><a href={MORSE_RUNNER_DOWNLOAD_URL} target="_blank" rel="noreferrer">Desktop Community Edition downloads</a></p>
            </details>
          </section>
          <details id="training-scratchpad-panel" class="training-section training-scratchpad" open hidden>
            <summary>Recall &amp; notes <span class="training-small">optional</span></summary>
            <p id="training-scratchpad-prompt" class="training-small"></p>
            <label for="training-scratchpad">Your scratchpad</label>
            <textarea id="training-scratchpad" rows="4" maxlength="10000" spellcheck="false" autocapitalize="off" aria-describedby="training-scratchpad-prompt training-scratchpad-status"></textarea>
            <p id="training-scratchpad-status" class="training-small" role="status">Autosaved on this device. Finish and save the block to sync notes with history.</p>
          </details>
          <details class="training-section" open>
            <summary>Exercise instructions</summary><div
              id="training-focus-instructions"
              class="training-original"
            >
            </div><div id="training-focus-settings" class="training-original">
            </div><a id="training-focus-source" target="_blank" rel="noreferrer"
              >View original source</a
            >
          </details>
          <div id="training-focus-text" class="training-section" hidden>
            <label
              >Text size <input
                id="training-focus-font"
                type="range"
                min="18"
                max="48"
                value="26"
              /></label
            ><pre id="training-sending-text" tabindex="0"></pre>
          </div>
          <div class="training-actions" id="training-sending-actions" hidden>
            <button type="button" id="training-sending-open" hidden>Record my sending (optional)</button>
          </div>
          <section id="training-sending-panel" class="training-section training-sending" aria-label="Optional sending capture" hidden></section>
          <div class="training-actions">
            <button class="primary" type="button" data-action="finish"
              >Finish block</button
            ><button type="button" data-action="pause-block"
              >Save for later</button
            >
          </div>
        </div>
      </section>

      <section id="training-week" aria-label="Schedule and history" hidden>
        <h2>The course ahead</h2><p>
          Class and practice are separate. Preparation is due before each
          meeting.
        </p><div id="training-meetings"></div>
        <details class="training-section">
          <summary>Practice history</summary><div id="training-history"></div>
        </details>
      </section>

      <section id="training-materials" aria-label="Instructor materials" hidden>
        <div class="training-today-heading">
          <div>
            <h2>Class materials</h2><p>
              Keep your instructor's wording and sending files close at hand.
            </p>
          </div><button type="button" data-action="add-material"
            >Add material</button
          >
        </div>
        <p class="training-small">
          “Prepare before class” adds a practice task. Class-only, reference,
          and unclassified material stay available without becoming homework.
        </p>
        <div id="training-material-list"></div>
      </section>

      <details class="training-panel training-settings">
        <summary>Preferences and your data</summary>
        <div class="training-panel-body">
          <label class="training-speed-preference">Short-recording default
            <select id="training-audio-preference" aria-describedby="training-speed-help">
              <option value="assigned">Assigned speed</option>
              <option value="next">Next faster official recording</option>
            </select>
          </label>
          <p id="training-speed-help" class="training-small">Saved automatically for future blocks. You can also change each exercise's recording speed in Today, Week, or Focus. Full faster passes count toward the same exercise.</p>
          <label
            >Calendar practice time (Eastern)<input
              id="training-reminder-time"
              type="time"
              value="09:00"
            /></label
          >
          <label>Calendar reminder duration
            <select id="training-calendar-duration" aria-describedby="training-calendar-duration-help">
              <option value="10">10 minutes</option>
              <option value="15">15 minutes</option>
            </select>
          </label>
          <p id="training-calendar-duration-help" class="training-small">Sets the calendar event length. Practice can be shorter or longer.</p>
          <label
            >Private class join link (optional)<input
              id="training-join-url"
              type="url"
              placeholder="https://"
            /></label
          >
          <button type="button" data-action="save-preferences"
            >Save preferences</button
          >
          <div class="training-section">
            <h3>Practice reminders</h3><p class="training-small">
              Create a private calendar subscription, then add its link in your
              calendar app. Anyone with the link can see practice times, but not
              your notes, scores, or curriculum. Replacing or revoking the link
              stops the old subscription.
            </p><div class="training-actions">
              <button type="button" data-action="calendar-create"
                >Create or replace calendar link</button
              ><button type="button" data-action="calendar-revoke"
                >Revoke calendar link</button
              >
            </div><div id="training-calendar-result" hidden>
              <label
                >Private calendar subscription URL<input
                  id="training-calendar-url"
                  type="url"
                  readonly
                /></label
              ><button type="button" data-action="calendar-copy"
                >Copy calendar link</button
              >
            </div><p
              id="training-calendar-status"
              class="training-small"
              role="status"
            >
            </p>
          </div>
          <p class="training-small">
            Offline practice is saved on this device, then synced when you
            reconnect. An expired sign-in will not discard your work.
          </p>
          <div class="training-actions">
            <button type="button" data-action="sync">Sync now</button><button
              type="button"
              data-action="export">Export all training data</button
            ><button type="button" data-action="clear">Clear this device</button
            ><a href="/api/cw-training/login">Renew sign-in</a>
          </div>
        </div>
      </details>
    </div>
    <noscript
      ><p>
        This practice companion needs JavaScript for its timer, player, and
        private curriculum.
      </p></noscript
    >

    <dialog id="training-finish-dialog">
      <form id="training-finish-form">
        <h2 id="training-finish-title">Finish this block</h2><label
          >Total minutes actually practiced<input
            id="training-finish-minutes"
            name="minutes"
            type="number"
            min="0"
            max="240"
            step="0.1"
            required
          /></label
        ><label id="training-finish-recall-label" hidden
          >Recall minutes (included in total)<input
            id="training-finish-recall" name="recall" type="number"
            min="0" max="240" step="0.1" value="0" required
          /></label
        ><p id="training-finish-scratchpad" class="training-small" hidden>Your scratchpad will be saved with this history entry.</p><label class="training-check"
          ><input
            id="training-finish-complete"
            name="complete"
            type="checkbox"
          /> <span id="training-finish-complete-label">I completed this exercise's requirements</span></label
        ><p id="training-finish-help" class="training-small"></p><p id="training-finish-recording" class="training-small" hidden></p>
        <div id="training-finish-sending" hidden>
          <p id="training-finish-sending-info" class="training-small"></p>
          <label class="training-check"><input id="training-finish-sending-summary" name="sendingSummary" type="checkbox" checked /> Include sending summary in history</label>
          <pre id="training-finish-sending-text" class="training-small training-sending-transcript"></pre>
          <label class="training-check"><input name="sendingRecordings" type="checkbox" checked /> Keep replay on this device</label>
          <p class="training-small">The ten most recent saved takes are kept here. Recordings do not sync to other devices and do not add practice minutes.</p>
        </div>
        <label
          >How did it feel? (optional)<select name="difficulty"
            ><option value="">No rating</option><option value="hard"
              >Hard</option
            ><option value="right">About right</option><option value="easy"
              >Easy</option
            ></select
          ></label
        ><label
          >Note or score (optional)<textarea
            id="training-finish-note"
            name="note"
            rows="2"
            maxlength="4000"></textarea></label
        ><div class="training-actions">
          <button class="primary" type="submit">Save practice</button><button
            id="training-finish-back"
            type="button"
            data-close>Keep practicing</button
          >
        </div>
      </form>
    </dialog>
    <dialog id="training-sending-history-dialog">
      <h2>Sending recording</h2>
      <div id="training-sending-history-content" class="training-sending"></div>
      <div class="training-actions"><button type="button" data-close>Close</button></div>
    </dialog>
    <dialog id="training-manual-dialog">
      <form id="training-manual-form">
        <h2>Log practice elsewhere</h2><label
          >Activity<select id="training-manual-task" name="task" aria-describedby="training-manual-help" required
          ></select></label
        ><p id="training-manual-help" class="training-small"></p><label
          >Minutes practiced<input
            type="number"
            name="minutes"
            min="0"
            max="240"
            step="0.1"
            value="15"
            required
          /></label
        ><label id="training-manual-passes-field"
          >Audio passes completed (if relevant)<input
            id="training-manual-passes"
            type="number"
            name="passes"
            min="0"
            max="100"
            step="1"
            value="0"
          /></label
        ><label id="training-manual-complete-field" class="training-check"
          ><input id="training-manual-complete" type="checkbox" name="complete" /> Requirements completed</label
        ><label
          >Note or score (optional)<textarea id="training-manual-note" name="note" rows="2" maxlength="3950"
          ></textarea></label
        ><div class="training-actions">
          <button class="primary" type="submit">Save practice</button><button
            type="button"
            data-close>Cancel</button
          >
        </div>
      </form>
    </dialog>
    <dialog id="training-material-dialog">
      <form id="training-material-form">
        <h2>Add instructor material</h2><label
          >Class<select id="training-material-session" name="session"
          ></select></label
        ><label>Title<input name="title" maxlength="200" required /></label
        ><label
          >Purpose<select name="usage"
            ><option value="unknown">Not sure yet</option><option
              value="preparation">Prepare before class</option
            ><option value="class">Use during class</option><option
              value="reference">Reference</option
            ></select
          ></label
        ><label
          >Original instructions or sending text<textarea
            id="training-material-text"
            name="text"
            rows="8"
            maxlength="100000"></textarea></label
        ><label
          >Import a text file<input
            id="training-material-file"
            type="file"
            accept=".txt,text/plain"
          /></label
        ><label
          >Resource link (optional)<input
            name="url"
            type="url"
            placeholder="https://"
          /></label
        ><p class="training-small">
          Text stays private. Saving preparation adds work; it does not replace
          completed or assigned curriculum.
        </p><div class="training-actions">
          <button class="primary" type="submit">Save material</button><button
            type="button"
            data-close>Cancel</button
          >
        </div>
      </form>
    </dialog>
    <dialog id="training-reading-dialog" class="training-reading-dialog">
      <h2 id="training-reading-title"></h2><p
        id="training-reading-usage"
        class="training-small"
      >
      </p><label
        >Text size<input
          id="training-reading-size"
          type="range"
          min="18"
          max="48"
          value="26"
        /></label
      ><pre id="training-reading-text" tabindex="0"></pre><div
        id="training-reading-link"
      >
      </div><div class="training-actions">
        <button type="button" data-action="practice-material"
          >Practice this material</button
        ><button type="button" data-close>Close</button>
      </div>
    </dialog>
  </div>
  <script>
    import { initTraining } from "../../lib/cw-training/client";
    initTraining();
  </script>
</BaseLayout>
