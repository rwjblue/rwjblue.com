---
import BaseLayout from "../../layouts/BaseLayout.astro";

const updated = "July 30, 2026";

const homeStation: Array<{
  label: string;
  name?: string;
  href?: string;
  text: string;
}> = [
  {
    label: "Radio",
    name: "Elecraft K4D",
    href: "/radio/equipment/elecraft-k4d/",
    text: " at the desk for home operating, contest practice, CW work, and experiments that benefit from a stable station.",
  },
  {
    label: "Primary HF antenna",
    name: "DX Commander Expedition",
    href: "/radio/equipment/dx-commander-expedition/",
    text: ", currently the main vertical at the QTH. The Signature 12.4 is intended to replace it as the permanent house vertical.",
  },
  {
    label: "Attic HF antenna",
    name: "Homebrew attic EFHW",
    href: "/radio/equipment/homebrew-attic-efhw/",
    text: ", arranged in a horseshoe around the attic perimeter and available as another transmit and receive path.",
  },
  {
    label: "Receive antenna",
    name: "Loop on the ground",
    href: "/radio/equipment/loop-on-ground-receive-antenna/",
    text: ", used for quieter receive and diversity comparisons with the K4D.",
  },
  {
    label: "VHF and UHF",
    name: "Diamond X50A",
    href: "/radio/equipment/diamond-x50a/",
    text: " in the attic as the primary fixed 2-meter and 70-centimeter antenna.",
  },
  {
    label: "Operating position",
    text: "A practical bench for listening, logging, debugging RF problems, and keeping the station easy to reconfigure.",
  },
];

const portableKit: Array<{
  label: string;
  name?: string;
  href?: string;
  text: string;
}> = [
  {
    label: "Field radios",
    name: "Elecraft KX2",
    href: "/radio/equipment/elecraft-kx2/",
    text: " and KX3 for portable HF, POTA activations, quick experiments, and lightweight setups.",
  },
  {
    label: "Radios to rotate in",
    name: "QRP Labs QMX",
    href: "/radio/equipment/qrp-labs-qmx/",
    text: " and QMX+ radios are available for field use but need deliberate operating time before they become familiar alternatives.",
  },
  {
    label: "Longer portable stays",
    name: "DX Commander Expedition",
    href: "/radio/equipment/dx-commander-expedition/",
    text: " is intended for camping, weekends away, and other extended setups once the Signature 12.4 takes over at home.",
  },
  {
    label: "Antennas",
    text: "Whips and wire antennas depending on the park, available supports, wind, time, and how much setup friction the outing can tolerate.",
  },
  {
    label: "Logging",
    text: "Portable logging is treated as part of the station: simple enough to use in the field, detailed enough to reconstruct what happened later.",
  },
];

const operatingFocus = [
  "CW practice and getting more comfortable at real on-air speeds.",
  "POTA activations, especially repeatable field workflows around Rhode Island parks.",
  "Antenna and station experiments that produce notes worth finding again.",
  "Contest weekends used as dense practice, not only as score-chasing.",
];
---

<BaseLayout
  title="My station / N1RWJ"
  description="The current N1RWJ home station, portable HF kit, antennas, and operating workflow notes."
  canonicalPath="/radio/shack/"
  backlinks
  searchType="Radio guide"
>
  <section class="page-intro">
    <p class="eyebrow">N1RWJ</p>
    <h1>My station</h1>
    <p>
      This is the current shape of my radio setup: the home station, portable
      HF kits, antennas, logging habits, and operating workflows behind the
      field notes on this site.
    </p>
    <p class="meta">Last updated {updated}</p>
    <nav class="path-links" aria-label="Station references">
      <a href="/radio/equipment/">Browse the equipment inventory</a>
    </nav>
  </section>

  <section class="section-block wide" aria-labelledby="home-station-title">
    <div class="section-heading">
      <p class="section-label">Station</p>
      <h2 id="home-station-title">Home station</h2>
    </div>
    <div class="setup-list">
      {
        homeStation.map((item) => (
          <div>
            <h3>{item.label}</h3>
            <p>
              {item.href && item.name && <a href={item.href}>{item.name}</a>}
              {item.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-block wide" aria-labelledby="portable-kit-title">
    <div class="section-heading">
      <p class="section-label">Field</p>
      <h2 id="portable-kit-title">Portable kit</h2>
    </div>
    <div class="setup-list">
      {
        portableKit.map((item) => (
          <div>
            <h3>{item.label}</h3>
            <p>
              {item.href && item.name && <a href={item.href}>{item.name}</a>}
              {item.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bridge" aria-labelledby="equipment-title">
    <p class="section-label">Reference</p>
    <h2 id="equipment-title">Equipment inventory</h2>
    <p>
      A curated list of the radios, antennas, paddles, power systems, supports,
      and test equipment that make up these setups. Individual pages provide
      stable links without turning this overview into a parts catalog.
    </p>
    <nav class="path-links" aria-label="Equipment inventory">
      <a href="/radio/equipment/">Browse radio equipment</a>
    </nav>
  </section>

  <section class="bridge" aria-labelledby="operating-focus-title">
    <p class="section-label">Practice</p>
    <h2 id="operating-focus-title">Operating focus</h2>
    <ul class="plain-list">
      {operatingFocus.map((item) => <li>{item}</li>)}
    </ul>
    <nav class="path-links" aria-label="Related radio paths">
      <a href="/radio/">Radio notes</a>
      <a href="/projects/2026-activate-all-ri-pota/">RI POTA tracker</a>
    </nav>
  </section>
</BaseLayout>
