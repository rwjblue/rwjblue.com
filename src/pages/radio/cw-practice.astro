---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CW_CALENDAR_PATH, cwActivities } from "../../lib/cw-practice";

const calendarPath = CW_CALENDAR_PATH;
---

<BaseLayout
  title="CW Practice Schedule / N1RWJ"
  description="A local-time schedule for the weekly K1USN SST, ICWC MST, and CWops CWT on-air Morse code activities."
  canonicalPath="/radio/cw-practice/"
  backlinks
  searchType="Tool"
>
  <section class="cw-clock-intro">
    <div>
      <p class="eyebrow">Radio / CW practice</p>
      <h1>CW Practice Schedule</h1>
      <p class="lede">
        The next Slow Speed Test, Medium Speed Test, and CWops Test sessions,
        shown in your current local time or UTC.
      </p>
    </div>
    <p class="cw-clock-zone" id="cw-clock-zone" aria-live="polite">Finding your time zone...</p>
  </section>

  <section class="cw-clock-tool" id="cw-practice-clock" aria-label="Upcoming CW practice sessions">
    <div class="cw-clock-controls">
      <div class="cw-clock-zone-toggle" role="radiogroup" aria-label="Time zone">
        <button type="button" data-zone="local" aria-checked="true" role="radio">Local time</button>
        <button type="button" data-zone="utc" aria-checked="false" role="radio">UTC</button>
      </div>
      <a class="cw-clock-calendar-link" href={calendarPath} data-calendar-subscribe>Subscribe to calendar</a>
    </div>

    <div class="cw-clock-status-grid">
      <button class="cw-clock-primary" id="cw-clock-primary" type="button">
        <span class="cw-clock-kicker" id="cw-clock-primary-kicker">Next up</span>
        <span class="cw-clock-activity" id="cw-clock-primary-activity">Loading schedule...</span>
        <span class="cw-clock-primary-time" id="cw-clock-primary-time"></span>
        <span class="cw-clock-countdown" id="cw-clock-primary-countdown"></span>
        <span class="cw-clock-progress" id="cw-clock-progress" aria-hidden="true">
          <span id="cw-clock-progress-fill"></span>
        </span>
        <span class="cw-clock-open-hint">Open exchange walkthrough <span aria-hidden="true">→</span></span>
      </button>

      <button class="cw-clock-next" id="cw-clock-next" type="button">
        <span class="cw-clock-kicker">After that</span>
        <span class="cw-clock-next-activity" id="cw-clock-next-activity"></span>
        <span class="cw-clock-next-time" id="cw-clock-next-time"></span>
        <span class="cw-clock-open-hint">Open exchange walkthrough <span aria-hidden="true">→</span></span>
      </button>
    </div>

    <section class="cw-clock-agenda" aria-labelledby="cw-clock-agenda-title">
      <div class="cw-clock-section-heading">
        <div>
          <p class="section-label">Coming up</p>
          <h2 id="cw-clock-agenda-title">The next few sessions</h2>
        </div>
        <p>Each session lasts one hour.</p>
      </div>
      <ol id="cw-clock-agenda-list"></ol>
    </section>

    <noscript>
      <p class="cw-clock-noscript">
        This schedule needs JavaScript to translate the fixed UTC sessions into
        your local time. The calendar subscription works without it.
      </p>
    </noscript>
  </section>

  <section class="cw-clock-subscribe" aria-labelledby="cw-clock-subscribe-title">
    <div>
      <p class="section-label">Calendar feed</p>
      <h2 id="cw-clock-subscribe-title">Let your calendar do the conversion.</h2>
      <p>
        Subscribe once and your calendar app will periodically refresh this
        server-managed feed. Sessions are stored in UTC, so they follow local
        daylight-saving changes and travel with your calendar automatically.
      </p>
    </div>
    <div class="cw-clock-subscribe-actions">
      <a href={calendarPath} data-calendar-subscribe>Subscribe</a>
      <button type="button" id="cw-clock-copy-feed" data-calendar-path={calendarPath}>Copy feed URL</button>
      <span id="cw-clock-copy-status" role="status"></span>
    </div>
  </section>

  <section class="cw-clock-reference" aria-labelledby="cw-clock-reference-title">
    <p class="section-label">At a glance</p>
    <h2 id="cw-clock-reference-title">A progression, not a speed requirement.</h2>
    <div class="cw-clock-reference-list">
      {
        cwActivities.map((activity) => (
          <button
            class={`cw-clock-reference-item cw-clock-reference-item--${activity.id}`}
            type="button"
            data-activity={activity.id}
          >
            <span>{activity.abbreviation}</span>
            <strong>{activity.speed}</strong>
            <p>{activity.name} · {activity.exchange}</p>
          </button>
        ))
      }
    </div>
  </section>

  <section class="cw-clock-resources" aria-labelledby="cw-clock-resources-title">
    <div class="cw-clock-resources-heading">
      <div>
        <p class="section-label">More ways to practice on air</p>
        <h2 id="cw-clock-resources-title">Practice without a score.</h2>
      </div>
      <p>
        These are guided or conversational contacts, so they sit outside the
        fixed-session calendar above.
      </p>
    </div>

    <div class="cw-clock-resource-grid">
      <article class="cw-clock-resource-card cw-clock-resource-card--nnn">
        <div class="cw-clock-resource-card-head">
          <span>Guided net</span>
          <code>CQ NNN</code>
        </div>
        <h3>Nervous Novice CW Net</h3>
        <p>
          A low-pressure place to make a standard contact or let it turn into a
          ragchew, at whatever speed works.
        </p>
        <div class="cw-clock-resource-next">
          <span>Next net</span>
          <time id="cw-resource-nnn-time">Finding the next Monday or Thursday...</time>
          <strong id="cw-resource-nnn-countdown"></strong>
        </div>
        <dl class="cw-clock-resource-facts">
          <div><dt>Schedule</dt><dd>Mondays &amp; Thursdays · 7 PM Central</dd></div>
          <div><dt>Listen near</dt><dd>7.033 MHz · 7.035 backup</dd></div>
        </dl>
        <div class="cw-clock-resource-actions">
          <button type="button" data-activity="nnn">How to join <span aria-hidden="true">→</span></button>
          <a href="https://w5ias.com/2026/06/29/cw-nets-change-frequencies/" target="_blank" rel="noreferrer">Current W5IAS notice <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <article class="cw-clock-resource-card cw-clock-resource-card--giving-back">
        <div class="cw-clock-resource-card-head">
          <span>Conversational practice</span>
          <code>GB K</code>
        </div>
        <h3>CWops Giving Back</h3>
        <p>
          Volunteers call for casual QSOs at a moderate pace. It is open to
          anyone, not only CW Academy students.
        </p>
        <div class="cw-clock-resource-next">
          <span>When to listen</span>
          <strong>Around 7 PM in each volunteer's local time</strong>
          <small>Check the live roster for a station near your time zone.</small>
        </div>
        <dl class="cw-clock-resource-facts">
          <div><dt>Pace</dt><dd>Usually 15-20 WPM</dd></div>
          <div><dt>Bands</dt><dd>Summer 20/40m · winter 40/80m</dd></div>
        </dl>
        <div class="cw-clock-resource-actions">
          <button type="button" data-activity="giving-back">How to join <span aria-hidden="true">→</span></button>
          <a href="https://cwops.org/giving-back/" target="_blank" rel="noreferrer">Live volunteer roster <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </div>
  </section>

  <dialog class="cw-clock-dialog" id="cw-dialog-sst" aria-labelledby="cw-dialog-sst-title">
    <div class="cw-clock-dialog-head">
      <div>
        <p class="section-label">K1USN Radio Club · up to 20 WPM</p>
        <h2 id="cw-dialog-sst-title">SST exchange walkthrough</h2>
      </div>
      <button type="button" class="cw-clock-dialog-close" aria-label="Close dialog">×</button>
    </div>
    <p class="cw-clock-dialog-summary">Send your first name and your state from the lower 48, province from Canada, or the literal <code>DX</code> from anywhere else, including Alaska and Hawaii. Do not send a country prefix. There is no RST in the exchange.</p>
    <ol class="cw-clock-walkthrough">
      <li><span>1</span><div><strong>Find a caller</strong><code>CQ SST K1ABC</code><p>Or call <code>CQ SST</code> yourself on a clear frequency.</p></div></li>
      <li><span>2</span><div><strong>Answer with your call</strong><code>N1RWJ</code><p>Send it once or twice, then listen for your call.</p></div></li>
      <li><span>3</span><div><strong>Copy their exchange</strong><code>N1RWJ ALEX MA</code><p>Log the other operator's first name and location.</p></div></li>
      <li><span>4</span><div><strong>Send yours</strong><code>GE ALEX ROB RI</code><p>A short greeting is welcome. Match the other operator's speed.</p></div></li>
      <li><span>5</span><div><strong>Finish the contact</strong><code>TU 73</code><p>Listen for confirmation before moving on.</p></div></li>
    </ol>
    <div class="cw-clock-dialog-notes">
      <p><strong>Suggested frequencies</strong><br />1.812-1.828, 3.528-3.545, 7.028-7.045, 14.028-14.045, 21.028-21.045, and 28.028-28.045 MHz.</p>
      <p>SST has no lower speed limit. Operators are asked to be patient and slow down as needed.</p>
    </div>
    <a class="cw-clock-rules-link" href="https://www.k1usn.com/sst_rules.html" target="_blank" rel="noreferrer">Official K1USN SST rules <span aria-hidden="true">↗</span></a>
  </dialog>

  <dialog class="cw-clock-dialog" id="cw-dialog-mst" aria-labelledby="cw-dialog-mst-title">
    <div class="cw-clock-dialog-head">
      <div>
        <p class="section-label">International CW Council · 20-25 WPM</p>
        <h2 id="cw-dialog-mst-title">MST exchange walkthrough</h2>
      </div>
      <button type="button" class="cw-clock-dialog-close" aria-label="Close dialog">×</button>
    </div>
    <p class="cw-clock-dialog-summary">Send your first name and the next sequential number in your log. There is no RST in the required exchange.</p>
    <ol class="cw-clock-walkthrough">
      <li><span>1</span><div><strong>Find a caller</strong><code>CQ MST K1ABC</code><p>Or find a clear frequency and call <code>CQ MST</code>.</p></div></li>
      <li><span>2</span><div><strong>Answer with your call</strong><code>N1RWJ</code><p>Wait for the running station to send your call back.</p></div></li>
      <li><span>3</span><div><strong>Copy their exchange</strong><code>N1RWJ ALEX 027</code><p>Log their first name and serial number.</p></div></li>
      <li><span>4</span><div><strong>Send yours</strong><code>ROB 001</code><p>Start at 001 and increment your number for each QSO.</p></div></li>
      <li><span>5</span><div><strong>Confirm and continue</strong><code>TU</code><p>The running station confirms the QSO and calls again.</p></div></li>
    </ol>
    <div class="cw-clock-dialog-notes">
      <p><strong>Suggested frequencies in the Americas</strong><br />1.812-1.828, 3.528-3.550, 7.028-7.050, 14.028-14.050, 21.028-21.050, and 28.028-28.050 MHz.</p>
      <p>Keep speeds around 20-25 WPM and slow down when requested. Running stations near 7.030 MHz should observe the event's QRP note.</p>
    </div>
    <a class="cw-clock-rules-link" href="https://internationalcwcouncil.org/mst-contest/" target="_blank" rel="noreferrer">Official ICWC MST rules <span aria-hidden="true">↗</span></a>
  </dialog>

  <dialog class="cw-clock-dialog" id="cw-dialog-cwt" aria-labelledby="cw-dialog-cwt-title">
    <div class="cw-clock-dialog-head">
      <div>
        <p class="section-label">CWops · usually 25+ WPM</p>
        <h2 id="cw-dialog-cwt-title">CWT exchange walkthrough</h2>
      </div>
      <button type="button" class="cw-clock-dialog-close" aria-label="Close dialog">×</button>
    </div>
    <p class="cw-clock-dialog-summary">Everyone is welcome. Members send their first name and CWops number; non-members send their first name and state, province, or DX country prefix. CW Academy students send their first name and CWA instead of a location.</p>
    <ol class="cw-clock-walkthrough">
      <li><span>1</span><div><strong>Find a caller</strong><code>CQ CWT K1ABC</code><p>Or call <code>CQ CWT</code> on a clear frequency.</p></div></li>
      <li><span>2</span><div><strong>Answer with your call</strong><code>N1RWJ</code><p>Listen for the running station to send your call.</p></div></li>
      <li><span>3</span><div><strong>Copy their exchange</strong><code>N1RWJ ALEX 1234</code><p>A member sends a name and CWops number. A non-member sends a state, province, or DX country prefix instead.</p></div></li>
      <li><span>4</span><div><strong>Send the right version</strong><code>ROB RI</code><p>As a member, send <code>ROB 1234</code>. As a CW Academy student, send <code>ROB CWA</code> instead of your state, province, or DX country prefix.</p></div></li>
      <li><span>5</span><div><strong>Confirm and continue</strong><code>TU</code><p>The running station confirms and returns to calling.</p></div></li>
    </ol>
    <div class="cw-clock-dialog-notes">
      <p><strong>Suggested frequencies</strong><br />Generally 28-45 kHz above the lower band edge on 10, 15, 20, 40, 80, and 160 meters.</p>
      <p>CWT can be fast, but the official guidance asks operators to slow down when called at a slower speed.</p>
    </div>
    <a class="cw-clock-rules-link" href="https://cwops.org/cwops-tests/" target="_blank" rel="noreferrer">Official CWops CWT rules <span aria-hidden="true">↗</span></a>
  </dialog>

  <dialog class="cw-clock-dialog cw-clock-dialog--nnn" id="cw-dialog-nnn" aria-labelledby="cw-dialog-nnn-title">
    <div class="cw-clock-dialog-head">
      <div>
        <p class="section-label">W5IAS · all speeds welcome</p>
        <h2 id="cw-dialog-nnn-title">Joining the Nervous Novice CW Net</h2>
      </div>
      <button type="button" class="cw-clock-dialog-close" aria-label="Close dialog">×</button>
    </div>
    <p class="cw-clock-dialog-summary">This is deliberately loose: make a basic contact, exchange a little more, or settle into a ragchew. Match a comfortable speed and ask for repeats whenever you need them.</p>
    <ol class="cw-clock-walkthrough">
      <li><span>1</span><div><strong>Tune and listen first</strong><code>7.033 MHz</code><p>Try 7.035 MHz if the primary frequency is busy or covered by QRM.</p></div></li>
      <li><span>2</span><div><strong>Listen for the net call</strong><code>CQ NNN</code><p>The net meets Monday and Thursday evenings at 7 PM Central.</p></div></li>
      <li><span>3</span><div><strong>Answer with your call</strong><code>N1RWJ</code><p>Send it once or twice, then wait for the other station to come back to you.</p></div></li>
      <li><span>4</span><div><strong>Exchange the basics</strong><code>RST · STATE · NAME</code><p>There is no rigid exchange. A standard callsign, signal report, and location is enough; add your name or keep chatting if you like.</p></div></li>
      <li><span>5</span><div><strong>Finish when ready</strong><code>TU 73</code><p>There is no score to submit. The successful contact is the point.</p></div></li>
    </ol>
    <div class="cw-clock-dialog-notes">
      <p><strong>Before getting on</strong><br />Check W5IAS for a recent frequency change or cancellation notice. The net does not publish a dependable end time.</p>
      <p><strong>Speed</strong><br />The organizer welcomes anything from very slow CW upward and asks operators to adjust to one another.</p>
    </div>
    <div class="cw-clock-dialog-links">
      <a class="cw-clock-rules-link" href="https://w5ias.com/sooner-sprint/" target="_blank" rel="noreferrer">W5IAS net details <span aria-hidden="true">↗</span></a>
      <a class="cw-clock-rules-link cw-clock-rules-link--secondary" href="https://w5ias.com/2026/06/29/cw-nets-change-frequencies/" target="_blank" rel="noreferrer">Current frequency notice <span aria-hidden="true">↗</span></a>
    </div>
  </dialog>

  <dialog class="cw-clock-dialog cw-clock-dialog--giving-back" id="cw-dialog-giving-back" aria-labelledby="cw-dialog-giving-back-title">
    <div class="cw-clock-dialog-head">
      <div>
        <p class="section-label">CWops · usually 15-20 WPM</p>
        <h2 id="cw-dialog-giving-back-title">Finding a Giving Back QSO</h2>
      </div>
      <button type="button" class="cw-clock-dialog-close" aria-label="Close dialog">×</button>
    </div>
    <p class="cw-clock-dialog-summary">Giving Back volunteers make themselves available for relaxed, conversational CW contacts. Anyone can answer them; CWops and CW Academy membership are not required.</p>
    <ol class="cw-clock-walkthrough">
      <li><span>1</span><div><strong>Check the live roster</strong><code>DAY · CALL · ZONE</code><p>Choose a volunteer whose evening lines up with yours. Most begin around 7 PM in their own local time.</p></div></li>
      <li><span>2</span><div><strong>Pick a seasonal band</strong><code>20/40m or 40/80m</code><p>Listen on 20 and 40 meters in summer, or 40 and 80 meters in winter, typically 30-39 kHz above the lower band edge.</p></div></li>
      <li><span>3</span><div><strong>Recognize the call</strong><code>CQ DE K6RB GB K</code><p>The <code>GB</code> before the final <code>K</code> identifies a Giving Back volunteer.</p></div></li>
      <li><span>4</span><div><strong>Answer with your call</strong><code>N1RWJ</code><p>Send at a speed you can copy comfortably. The volunteer is there to help you get a useful QSO.</p></div></li>
      <li><span>5</span><div><strong>Have a normal conversation</strong><code>NAME · QTH · RIG</code><p>There is no contest exchange. Share as much or as little as you are comfortable copying.</p></div></li>
    </ol>
    <div class="cw-clock-dialog-notes">
      <p><strong>Typical ranges</strong><br />14.030-14.039, 7.030-7.039, or 3.530-3.539 MHz, depending on season and conditions.</p>
      <p><strong>Why there is no countdown</strong><br />Volunteers operate on different weekdays in their own time zones; the official live roster is the reliable source.</p>
    </div>
    <a class="cw-clock-rules-link" href="https://cwops.org/giving-back/" target="_blank" rel="noreferrer">CWops Giving Back roster <span aria-hidden="true">↗</span></a>
  </dialog>

  <script>
    import { initCwPracticeClock } from "../../lib/cw-practice-client";

    initCwPracticeClock();
  </script>
</BaseLayout>
