---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {
  connectedEquipment,
  EQUIPMENT_CATEGORIES,
  EQUIPMENT_USE_CONTEXT_LABELS,
  formatEquipmentDate,
  getEquipment,
} from "../../../lib/equipment";

export async function getStaticPaths() {
  const equipment = await getEquipment();
  return equipment.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      connections: connectedEquipment(entry, equipment),
    },
  }));
}

const { entry, connections } = Astro.props;
const { Content } = await render(entry);
const canonicalPath = `/radio/equipment/${entry.id}/`;
const category = EQUIPMENT_CATEGORIES.find(
  (candidate) => candidate.id === entry.data.category,
);
const statusLabel =
  entry.data.status === "current"
    ? "Current equipment"
    : entry.data.status === "incoming"
      ? "Incoming"
      : "Retired equipment";
const history = [
  ...(entry.data.acquired
    ? [
        {
          date: entry.data.acquired,
          title: "Acquired",
          details: undefined,
          note: undefined,
        },
      ]
    : []),
  ...entry.data.history,
].sort(
  (left, right) => left.date.localeCompare(right.date),
);
---

<BaseLayout
  title={`${entry.data.name} / Radio equipment / N1RWJ`}
  description={entry.data.summary}
  canonicalPath={canonicalPath}
  backlinks
  searchType="Radio guide"
>
  <Breadcrumbs
    items={[
      { name: "Home", path: "/" },
      { name: "Radio", path: "/radio/" },
      { name: "Equipment", path: "/radio/equipment/" },
      { name: entry.data.name, path: canonicalPath },
    ]}
  />

  <article class="document equipment-document">
    <header>
      <p class="eyebrow">Equipment</p>
      <h1>{entry.data.name}</h1>
      <p class="equipment-meta">
        <span>{category?.label ?? entry.data.category}</span>
        <span>{statusLabel}</span>
        {
          entry.data.quantity > 1 && (
            <span>{entry.data.quantity} owned</span>
          )
        }
        {entry.data.state && <span>{entry.data.state}</span>}
        {
          entry.data.acquired && (
            <span>Acquired {formatEquipmentDate(entry.data.acquired)}</span>
          )
        }
        {
          entry.data.serialNumber && (
            <span>Serial {entry.data.serialNumber}</span>
          )
        }
        {
          entry.data.useContexts.map((context) => (
            <span>{EQUIPMENT_USE_CONTEXT_LABELS[context]}</span>
          ))
        }
      </p>
      <p>{entry.data.summary}</p>
    </header>

    {
      entry.data.image && (
        <figure class="equipment-figure">
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt ?? entry.data.name}
          />
          {
            entry.data.imageSourceName && entry.data.imageSourceUrl && (
              <figcaption>
                Product photo:{" "}
                <a
                  href={entry.data.imageSourceUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  {entry.data.imageSourceName}
                </a>
              </figcaption>
            )
          }
        </figure>
      )
    }

    <Content />

    {
  entry.data.history.length > 0 && (
        <section
          class="equipment-history"
          aria-labelledby="equipment-history-title"
        >
          <p class="section-label">Lifecycle</p>
          <h2 id="equipment-history-title">History</h2>
          <ol>
            {history.map((event) => (
              <li>
                <time datetime={event.date}>
                  {formatEquipmentDate(event.date)}
                </time>
                <div>
                  <h3>
                    {event.note ? (
                      <a href={event.note}>{event.title}</a>
                    ) : (
                      event.title
                    )}
                  </h3>
                  {event.details && <p>{event.details}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      connections.length > 0 && (
        <section
          class="equipment-connections"
          aria-labelledby="equipment-connections-title"
        >
          <p class="section-label">Station relationships</p>
          <h2 id="equipment-connections-title">Connected equipment</h2>
          <p>
            Equipment currently connected with this item as part of a home or
            portable station.
          </p>
          <nav class="path-links" aria-label="Connected equipment">
            {connections.map((connection) => (
              <a href={`/radio/equipment/${connection.id}/`}>
                {connection.data.name}
              </a>
            ))}
          </nav>
        </section>
      )
    }

    {
      (entry.data.externalUrl || entry.data.dxEngineeringUrl) && (
        <nav class="path-links" aria-label="Equipment reference">
          {
            entry.data.externalUrl && (
              <a
                href={entry.data.externalUrl}
                target="_blank"
                rel="noreferrer"
              >
                Manufacturer product page
              </a>
            )
          }
          {
            entry.data.dxEngineeringUrl && (
              <a
                href={entry.data.dxEngineeringUrl}
                target="_blank"
                rel="noreferrer"
              >
                DX Engineering listing
              </a>
            )
          }
        </nav>
      )
    }
  </article>
</BaseLayout>
