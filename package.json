    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.3.1",
    "es-module-lexer": "^2.3.2",
    "jsqr": "^1.4.0",
    "markdown-it": "^15.0.1",
    "miniflare": "^4.20260730.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
